# 问渠实例根地址：必须带 context-path（本机 /ai）
WENQU_BASE_URL=http://127.0.0.1:8090/ai

# seed 用：登录态账号（仅用于签发一把样例专用 Key，不会写进浏览器）
WENQU_ADMIN_ID=admin
WENQU_ADMIN_PASSWORD=

# seed 产出 / 可手工填：样例专用 API Key
WENQU_API_KEY=

# 一个已存在的智能体 id（建 run 用）
WENQU_AGENT_ID=e91213cc5bd6d643bffd26a54e6b5a4e

# 仅 backend-node：webhook 签名密钥，必须与智能体 callback_secret 的明文一致
WENQU_CALLBACK_SECRET=local-dev-secret

# 仅 backend-python：已发布的工作流 id（draft 不能触发，见该样例 README）
WENQU_WORKFLOW_ID=

# 仅 widget-static：已发布智能体的分享 token（/s/{token}，不是 API Key）
WENQU_SHARE_TOKEN=

# 仅 frontend-proxy：自家登录态演示令牌（生产换成真实会话校验）
PROXY_SESSION_TOKEN=demo-session
