<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.15</version>
        <relativePath/>
    </parent>

    <groupId>com.wenqu</groupId>
    <artifactId>wenqu</artifactId>
    <version>1.0.1-SNAPSHOT</version>
    <name>wenqu</name>
    <description>WenQu (问渠) - AI 文档问答助手 / RAG Knowledge Assistant</description>

    <properties>
        <java.version>17</java.version>
        <spring-ai.version>1.1.8</spring-ai.version>
        <!-- Spring AI Alibaba：SubAgent 并行编排 / 工作流（Graph + Agent Framework）。
             选 1.1.2.x 线（适配 Spring AI 1.1.x）；spring-ai-bom 会把其传递的 spring-ai-* 收敛到 1.1.8 -->
        <spring-ai-alibaba.version>1.1.2.3</spring-ai-alibaba.version>
        <mybatis-plus.version>3.5.12</mybatis-plus.version>
        <!-- MCP Java SDK 版本：与 spring-ai-mcp 1.1.8 内部对齐的 0.18.3
             （spring-ai-alibaba-graph-core 传递的 0.14.0 已被仲裁掉：本地只有其 pom 没下载 jar） -->
        <mcp.version>0.18.3</mcp.version>
        <poi.version>5.5.1</poi.version>
        <lombok.version>1.18.46</lombok.version>
        <!-- AgentScope Java：agentx 运行时的宿主框架（Phase 0 实测定案（结论账已并入知识卡与 README 的框架平移章节））。
             刻意选 2.1.0-BETA1 而非稳定版 2.0.4：AgentSession（后台续跑/运行中插话/HITL 待办持久化/
             按游标续流）只在 BETA1 存在，而这几件正是问渠手写运行时最贵的一层；稳定线 2.0.4 里没有该类。
             版本风险由 Phase 0 实测与双跑对账兜住（已无引擎切换开关，单一引擎恒走框架）。 -->
        <agentscope.version>2.1.0-BETA1</agentscope.version>
    </properties>

    <dependencies>
        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- 健康检查/可观测性 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- SAML 2.0 服务端（企业级身份治理）：仅启用 SAML2 Login 过滤链（/saml2/**、/login/saml2/**），
             其余路径由 SamlSecurityConfig 的兜底链全放行——应用鉴权仍是拦截器 + JWT 自有体系，
             Spring Security 在这里只承担 SAML 协议（AuthnRequest 生成 / Response 验签，OpenSAML 5），
             不接管鉴权语义。版本由 Boot 父 POM（spring-security-bom）管理。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-saml2-service-provider</artifactId>
        </dependency>
        <!-- 敏感数据信封加密（Phase 0 密钥集中与轮换）：JWE = RSA-OAEP-256 包裹 AES-GCM 数据密钥，
             header 里带 kid（密钥版本）⇒ 轮换与「双密钥过渡期」是 JOSE 标准语义，不再自己定密文格式。
             顺带补上原分块 RSA 没有的东西：GCM 认证标签（完整性）。版本由 Boot 父 POM 管理。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
        </dependency>
        <!-- 密钥文件读取：PEMParser 认 PKCS#1 / PKCS#8 v1 / OpenSSL 3 的 v2（JCA 的 PKCS8EncodedKeySpec
             对 openssl genpkey 的产物直接报 algid parse error）。随 OpenSAML 一起已在包里，此处显式声明
             为直接使用，避免哪天 SAML 依赖变动把密钥读取带走。 -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcpkix-jdk18on</artifactId>
            <version>1.72</version>
        </dependency>
        <!-- 限流降级用的令牌桶原语（Phase 0 P8：Redis 不可用时 fail-closed）：Bandwidth/GCRA 与
             LocalBucket 交给 Bucket4j，只引无依赖的 core；跨副本主路径仍走 Redis 原子计数。
             刻意不用 bucket4j-redis：它按 jedis 4.4.6 / lettuce 6.1.8 编译，本包是 jedis 7.4.1，
             代理层会撞 NoSuchMethodError。 -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>
        <!-- 降级令牌桶的身份缓存：Bucket4j 本身不管「按身份建桶」，用 Guava Cache 的过期策略兜住
             无上限的身份基数（传递依赖里已有 31.1-jre，这里显式声明为直接使用并钉住同一版本）。 -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>31.1-jre</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Spring AI Redis VectorStore 自动配置依赖 Jedis（仅 Lettuce 时不满足 @ConditionalOnClass）。
             版本钉死 7.4.1：① agentscope-extensions-redis 的 RedisAgentStateStore 需要 UnifiedJedis（jedis 7.x）；
             ② Spring AI 1.1.8 的 RedisVectorStore 已用 JedisPooled + redis/clients/jedis/json/Path2 + search 模块，
                这些只存在于 jedis 5+，3.3.0 实际无法驱动该向量库；③ ConfigService 仅用 Jedis(host,port,timeout)/
                auth(String)/subscribe(JedisPubSub,String...)，7.4.1 均保留。 -->
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>7.4.1</version>
        </dependency>

        <!-- Spring AI（1.1 起 starter 更名，由 spring-ai-bom 管理版本） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
        </dependency>
        <!-- MCP 客户端：把用户在设置页配置的外部 MCP Server 工具动态接入 Function Calling
             （McpClientService 使用；传递依赖 io.modelcontextprotocol.sdk:mcp 0.18.3，版本由 spring-ai-bom 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp</artifactId>
        </dependency>
        <!-- MCP 服务端 WebMVC 传输层（McpServerService 把智能体发布为 /ai/mcp/{token} 端点用）。
             必须显式声明：spring-ai-mcp 对它俩的依赖标了 <optional>true</optional>，optional 不向下传递，
             仅靠 spring-ai-mcp 拿不到 WebMvcStatelessServerTransport（编译报「找不到符号」）。
             版本号必须与 spring-ai-mcp 内置的 mcp sdk 对齐（1.1.8 → 0.18.3），混版会出二进制不兼容。 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-spring-webmvc</artifactId>
            <version>${mcp.version}</version>
        </dependency>

        <!-- MyBatis-Plus -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <!-- 3.5.9 起分页拦截器拆到独立构件，selectPage 必须依赖它才能生效 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
            <version>${mybatis-plus.version}</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Apache POI 解析 Word/Excel/PPT（scratchpad 承载旧版二进制 .ppt 的 HSLF） -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-scratchpad</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <!-- PDFBox 解析 PDF（纯文本抽取） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <optional>true</optional>
        </dependency>
        <!-- Alibaba Fastjson -->
        <dependency>
            <groupId>com.alibaba.fastjson2</groupId>
            <artifactId>fastjson2</artifactId>
            <version>2.0.31</version>
        </dependency>
        <!-- 中文分词（jieba，替换自研 2-gram/4-gram 启发式） -->
        <dependency>
            <groupId>com.huaban</groupId>
            <artifactId>jieba-analysis</artifactId>
            <version>1.0.2</version>
        </dependency>
        <!-- tiktoken Java 实现（BPE 精确 token 计数，上下文预算/用量估算用；纯 Java 零传递依赖） -->
        <dependency>
            <groupId>com.knuddels</groupId>
            <artifactId>jtokkit</artifactId>
            <version>1.1.0</version>
        </dependency>
        <!-- HTML 解析（网页 URL 导入知识库：正文提取与结构化分块） -->
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.15.4</version>
        </dependency>
        <!-- Web Push（RFC 8291 消息加密 + RFC 8006 VAPID）：站内通知推到浏览器系统级通知。
             选它而不是 nl.martijndwars:web-push 的理由是依赖面：后者要拖 async-http-client /
             httpasyncclient / jose4j / bouncycastle / jcommander 五件，而这一件只用 JDK 密码学
             与 java.net.http，唯一编译期依赖 kotlin-stdlib 已在 classpath 上（Spring AI 带进来的），
             等于零新增传递依赖。 -->
        <dependency>
            <groupId>com.interaso</groupId>
            <artifactId>webpush</artifactId>
            <version>1.2.0</version>
        </dependency>
        <!-- SpringDoc OpenAPI (Swagger UI)，Boot 3.5 对应 2.8.x -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>2.8.8</version>
        </dependency>

        <!-- Spring AI Alibaba：多智能体与工作流编排（SubAgent 并行编排用）
             提供 Agent Framework（ReactAgent/ParallelAgent/LlmRoutingAgent/Supervisor 等）
             与底层 Graph（StateGraph：并行条件边、聚合策略、checkpoint、HITL）。
             注意：它传递引入 fastjson 1.x（与项目 fastjson2 并存，groupId 不同不冲突） -->
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
            <artifactId>spring-ai-alibaba-agent-framework</artifactId>
            <version>${spring-ai-alibaba.version}</version>
        </dependency>

        <!-- AgentScope Java：agentx 运行时的框架本体（HarnessAgent 推理循环 + Toolkit + 权限
             + AgentSession 会话调度 + Plan Mode + 上下文压缩）。控制流由框架持有，本仓库不再
             自研等价物；问渠只出领域工具（检索/知识库）与前端事件词汇适配。
             模型走 openai 扩展而非 dashscope：问渠 c_ai_provider.base_url 实测全是 OpenAI 兼容网关。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-harness</artifactId>
        </dependency>
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-model-openai</artifactId>
        </dependency>
        <!-- 框架会话状态与跨副本协调的存储后端（RedisAgentStateStore / RedisDistributedStore）：
             框架默认把状态落在 ~/.agentscope/state/**（本地文件，容器重建即丢——会让多轮对话失忆，
             2026-10-21 线上事故即由此而来），本工程恒走 Redis，连接参数复用 spring.data.redis。 -->
        <dependency>
            <groupId>io.agentscope</groupId>
            <artifactId>agentscope-extensions-redis</artifactId>
        </dependency>

        <!-- 单元测试（JUnit 5 + Mockito + AssertJ，版本由 Boot 父 POM 管理）：
             只覆盖不需要 Spring 上下文的纯逻辑断言（如配置保存的未知键拒绝口径） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- OpenSAML 不发布到 Maven Central（4.x/5.x 均只在 Shibboleth 官方仓库），
         Spring Security SAML2 服务端（spring-security-saml2-service-provider）依赖它做协议处理。
         官方文档要求：https://docs.spring.io/spring-security/reference/servlet/saml2/index.html -->
    <repositories>
        <repository>
            <id>shibboleth-releases</id>
            <name>Shibboleth Releases (OpenSAML)</name>
            <url>https://build.shibboleth.net/maven/releases/</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <!-- Spring AI BOM 统一管理各模块版本（1.1 GA 起无需 milestone 仓库，Maven Central 即可） -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!-- AgentScope 各扩展模块同版本发布，用它的 BOM 收口传递依赖 -->
            <dependency>
                <groupId>io.agentscope</groupId>
                <artifactId>agentscope-bom</artifactId>
                <version>${agentscope.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <finalName>wenqu</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- 保留方法参数名（Spring MVC @RequestParam/@PathVariable 反射需要；IDE 直跑可能不带） -->
                    <parameters>true</parameters>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>