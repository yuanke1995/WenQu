# 问渠 docker compose 环境变量模板
# 用法：cp .env.example .env 后填写真实值
# （.env 已被 .gitignore 忽略；切勿把含真实密钥的 .env 提交入库）

# 数据库 root 密码（compose 内置 MySQL 与 app 共用；备份 mysqldump 也用它）
DB_PASSWORD=

# 登录令牌签名密钥（≥32 位随机串）：openssl rand -base64 48
# 写死勿改——改动后所有已发登录令牌立即失效；多副本部署必须一致
AI_JWT_SECRET=

# Meilisearch master key（≥16 字节）：openssl rand -hex 32
# compose 必填（meilisearch 容器以它初始化）；应用侧默认关键词引擎为 mysql（零依赖），
# 在设置页把引擎切到 meilisearch 时才实际使用
AI_MEILI_KEY=

# 容器时区（智能体/工作流定时任务 cron 按此时区求值；默认 Asia/Shanghai）
# TZ=Asia/Shanghai

# 后端对外直连端口（默认仅绑回环 127.0.0.1:8090，走 nginx 反代时勿改）
# APP_PUBLISH=8090

# JVM 内存（默认 -Xms256m -Xmx1400m；4G 机器保持默认，2G 机器建议 -Xms128m -Xmx512m）
# JAVA_OPTS=-Xms256m -Xmx1400m
