# ===== 依赖与构建产物 =====
node_modules/
dist/
target/
*.log

# ===== IDE / 编辑器 =====
.idea/
*.iml
.vscode/
.DS_Store
__pycache__/

# ===== 本地敏感配置 =====
# .env.example 是模板（含占位符），必须保留跟踪，故用精确匹配而非 .env*
.env
.env.local
.env.*.local
config/application-local.yml
# 注：deploy/sandbox-provisioner/.env 等子目录的本地覆盖项由该目录自己的 .gitignore 管，
# 不在此处重复声明；sandbox.env 是 docker-compose 挂载进容器的部署输入，需保持跟踪。

# ===== 运行时数据与本地资料 =====
# data/ 是知识库语料（图片/PDF 解析产物，体积大）；data.ms/ 是运行时状态库（LMDB）。
# 两个名字相近但语义完全不同，容易误改，这里显式区分。
/data/
/data.ms/
# 部署手册等正式文档随仓走；效果图与方案统一放 design/（随仓跟踪）。
/dumps/
/dump/
/user-data/
# 本机运行日志（logback 按大小滚动，目录里还有 .gz 归档，*.log 那条盖不住）。
# 这是开发机本地栈写出来的东西，不是交付物；线上日志走容器与运维侧，不随仓走。
/logs/

# ===== AI 工具链本地目录 =====
/.workbuddy/
# AgentScope 框架运行时状态目录：本地跑对话时由框架临时建出，含 bus/queues、
# async-tools、wenqu/tasks 等短生命周期文件（IDE 文件监视器常因此报 ENOENT），
# 也含个人记忆文件（MEMORY.md、日账、plans）。跑完即清理，不入库。
# 例外：/.zcode/skills/ 是仓内开发规范与路线图账本，随仓走（2026-11-06 拍板）。
/.agentscope/
/.qoder/
/.pyenv/
/.zcode/*
!/.zcode/skills/
/.md/
/.vite/
/.zcodeignore

# ===== 工具生成的临时产物（可再生，不入库）=====
# 一次性截图、调试快照、分享包、预览帧用完即弃；需要留档的设计稿放 design/（随仓）。
/.trae/documents/
/.trae-html-share-packages/
/.playwright-mcp/
/.screenshots/
/preview/

# ===== npm 误生成物 =====
# 根目录无前端依赖，npm 误生成的空壳锁文件不入库；
# 前端锁文件在 web/package-lock.json，由上面的 node_modules/ 规则区分目录后正常跟踪。
/package-lock.json

# ===== 部署与运维脚本的本地运行时数据 =====
/deploy/sandbox-provisioner/data.ms/
/scripts/mac/data.ms/
/scripts/win/data.ms/
# ===== 测试代码：判定核单测随仓库交付，手工/临时夹具仍留本地 =====
# 2026-11-08 起改为白名单：src/test 下的纯单元测试入库（CI 要能真跑），
# 依赖真实库/真实 key/手工夹具的测试放 src/test/java/**/manual/ 并保持不入库。
/src/test/java/**/manual/
/.mockup/
/skill-projections/
/web/scripts/
/.wenqu/
