# 开发环境：直连 vite /proxy（转发到 http://localhost:8090/ai）
VITE_API_BASE=/proxy/api/ai
# 开发用内部 token（生产由平台网关注入，不在此配置）
# 真实值勿入库：本地开发请在 .env.development.local 中覆盖（该文件已被 git 忽略）
VITE_TRUSTED_TOKEN=

# 管理员访问口令（对应后端 AI_ADMIN_TOKEN）：本地联调管理员功能时填写，与后端配置一致。
# 生产不要写在此公共文件——由部署环境注入 VITE_ADMIN_TOKEN，或管理员运行时在页面输入（仅存本机 localStorage）。
# VITE_ADMIN_TOKEN=
