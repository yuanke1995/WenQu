# 沙盒 provisioner 部署覆盖项（本机/线上部署维护，不进git）
#
# 用法：cp .env.example .env 后填真实值，再 docker compose up -d
# 改完需重建容器：docker compose up -d（改 .env 不会自动重启已运行的容器）

# ===== 访问令牌：必须 ≥32 字符，且与设置页「沙盒 → 访问令牌」完全一致=====
# 不设则回落到基础文件里的 wenqu-local-dev-sandbox-provisioner-token —— 那是本地开发默认值，
# 线上必须换掉。生成：openssl rand -hex 32
# 注意 app.py provisioner_token() 与 ProvisionerSandboxProvider.token() 两侧都是 fail-closed：
# 少于 32 字符直接拒绝启用，不会静默降级。
SANDBOX_PROVISIONER_TOKEN=

# ===== 沙盒运行时镜像（可选）=====
# 容器内 gem 用户不在 sudoers 里，apt/pip 安装必然权限不足 —— 运行时依赖必须烧进镜像层。
# 需要 JDK / Node / Playwright 时，用派生镜像：
#   cd sandbox-image && docker build -t all-in-one-sandbox:1.11.0-jdk17 .
# 保持注释则用官方 all-in-one-sandbox:1.11.0（core profile，无浏览器/VNC/Jupyter）。
# 派生镜像含 Playwright+Chromium，体积明显大于 12GB 基线，磁盘要留够。
# 改完需重建 provisioner；已存在的旧沙盒容器仍用旧镜像，等空闲回收（默认 60 分钟）后生效。
# SANDBOX_IMAGE=all-in-one-sandbox:1.11.0-jdk17

# ===== 运行时 profile（可选）=====
# core = 关闭浏览器/VNC/Jupyter/CodeServer，只留文件与 shell（本工程只用到这两组）。
# SANDBOX_RUNTIME_PROFILE=core

# ===== 主compose 的 Docker 网络名（仅 docker-compose.prod.yml 读取）=====
# 网络名 = 主 compose 所在目录名 + _default（主 compose 未声明 name 时）。
# 用 docker network ls 核对后填，例如 wenqu_default。
WENQU_MAIN_NETWORK=wenqu_default
